    {
      "name": "window",
      "type": "select",
      "label": "Period",
      "default": "today",
      "help": "To-day is BirdNET-Go's day as it fills. This week is the last seven days together, from BirdNET-Go's species summary.",
      "choices": [
        {
          "value": "today",
          "label": "To-day"
        },
        {
          "value": "week",
          "label": "This week"
        }
      ],
      "show_if": {
        "source": "birdnet_go"
      }
    },
    {
      "name": "days",
      "type": "select",
      "label": "Looking back",
      "default": "30d",
      "choices": [
        {
          "value": "7d",
          "label": "A week"
        },
        {
          "value": "14d",
          "label": "Two weeks"
        },
        {
          "value": "30d",
          "label": "A month"
        },
        {
          "value": "90d",
          "label": "Three months"
        },
        {
          "value": "365d",
          "label": "A year"
        }
      ],
      "show_if": {
        "source": "inaturalist"
      }
    },
    {
      "name": "quality",
      "type": "select",
      "label": "Observations",
      "default": "research",
      "choices": [
        {
          "value": "research",
          "label": "Research grade: the community agrees on the species"
        },
        {
          "value": "",
          "label": "Any with a species, agreed or not"
        }
      ],
      "show_if": {
        "source": "inaturalist"
      }
    },
    {
      "name": "count",
      "type": "slider",
      "label": "How many",
      "default": 8,
      "min": 2,
      "max": 32,
      "step": 1,
      "help": "Specimens on the sheet, picked by Order. The more there are, the smaller each is; Scale below can shrink the whole arrangement further."
    },
    {
      "name": "order",
      "type": "select",
      "label": "Order",
      "default": "most",
      "help": "Which species make the sheet when more were heard or recorded than fit, and their order: the most heard, the rarest (new arrivals first), the latest, or a daily mix.",
      "choices": [
        {
          "value": "most",
          "label": "Most heard or recorded"
        },
        {
          "value": "rarest",
          "label": "Rarest here"
        },
        {
          "value": "latest",
          "label": "Most recently heard or seen"
        },
        {
          "value": "mix",
          "label": "Mix, a different pick each day"
        }
      ]
    },
    {
      "name": "exclude",
      "type": "textarea",
      "label": "Leave out",
      "default": "",
      "help": "Species to leave off the sheet, one per line: a common or scientific name, a genus (Columba drops every pigeon in it), a kind (Insecta, insects, Birds) or a pattern such as *gull. An excluded species frees its place for the next. Case and accents don't matter."
    },
    {
      "name": "min_confidence",
      "type": "select",
      "label": "Minimum confidence",
      "default": "70",
      "help": "Detections BirdNET is less sure of than this are left out.",
      "choices": [
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "60",
          "label": "60%"
        },
        {
          "value": "70",
          "label": "70%"
        },
        {
          "value": "80",
          "label": "80%"
        },
        {
          "value": "90",
          "label": "90%"
        }
      ],
      "show_if": {
