    {
      "name": "window",
      "type": "select",
      "label": "Period",
      "default": "today",
      "help": "To-day is BirdNET-Go's day as it fills. This week is the last seven days together, from BirdNET-Go's species summary.",
      "choices": [
        {
          "value": "today",
          "label": "To-day"
        },
        {
          "value": "week",
          "label": "This week"
        }
      ],
      "show_if": {
        "source": "birdnet_go"
      }
    },
    {
      "name": "days",
      "type": "select",
      "label": "Looking back",
      "default": "30d",
      "choices": [
        {
          "value": "7d",
          "label": "A week"
        },
        {
          "value": "14d",
          "label": "Two weeks"
