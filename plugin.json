    {
      "name": "window",
      "type": "select",
      "label": "Period",
      "default": "today",
      "help": "To-day is BirdNET-Go's day as it fills. This week is the last seven days together, from BirdNET-Go's species summary.",
      "choices": [
        {
          "value": "today",
          "label": "To-day"
        },
        {
          "value": "week",
          "label": "This week"
        }
      ],
      "show_if": {
        "source": "birdnet_go"
      }
    },
    {
      "name": "days",
      "type": "select",
      "label": "Looking back",
      "default": "30d",
      "choices": [
        {
          "value": "7d",
          "label": "A week"
        },
        {
          "value": "14d",
          "label": "Two weeks"
        },
        {
          "value": "30d",
          "label": "A month"
        },
        {
          "value": "90d",
          "label": "Three months"
        },
        {
          "value": "365d",
          "label": "A year"
        }
      ],
      "show_if": {
        "source": "inaturalist"
      }
    },
    {
      "name": "quality",
      "type": "select",
      "label": "Observations",
      "default": "research",
      "choices": [
        {
          "value": "research",
          "label": "Research grade: the community agrees on the species"
        },
        {
          "value": "",
          "label": "Any with a species, agreed or not"
        }
      ],
      "show_if": {
        "source": "inaturalist"
      }
    },
    {
      "name": "count",
      "type": "select",
      "label": "How many",
      "default": "8",
      "help": "Specimens on the sheet: the most heard or recorded first.",
      "choices": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "12",
          "label": "12"
        },
        {
          "value": "16",
          "label": "16"
        }
      ]
    },
    {
      "name": "exclude",
      "type": "textarea",
      "label": "Leave out",
      "default": "",
      "help": "Species to leave off the sheet, one per line: a common or scientific name, a genus (Columba drops every pigeon in it), a kind (Insecta, insects, Birds) or a pattern such as *gull. An excluded species frees its place for the next. Case and accents don't matter."
    },
    {
      "name": "pictures",
      "type": "select",
      "label": "Pictures",
      "default": "free",
      "help": "Plates and photos cost nothing. AI paintings paint each species once, from a photo of it, in the style below, on white paper so the cut-out is clean, at about US$0.04 a species; the sheet shows plates and photos until each painting lands. Needs a fal.ai key in this widget's settings.",
      "choices": [
        {
          "value": "free",
          "label": "Plates and photos"
        },
        {
          "value": "gen",
          "label": "AI paintings"
        }
      ]
    },
    {
      "name": "art_style",
      "type": "select",
      "label": "Art style",
      "default": "gould",
      "show_if": {
        "pictures": "gen"
      },
      "choices": [
        {
          "value": "gould",
          "label": "Hand-coloured lithograph (Gould)",
          "group": "Plates and prints"
        },
        {
          "value": "audubon",
          "label": "Watercolour after Audubon",
          "group": "Plates and prints"
        },
        {
          "value": "engraving",
          "label": "Black-ink engraving",
          "group": "Plates and prints"
        },
        {
          "value": "woodblock",
          "label": "Japanese woodblock print",
          "group": "Plates and prints"
        },
        {
          "value": "linocut",
          "label": "Linocut",
          "group": "Plates and prints"
        },
        {
          "value": "harper",
          "label": "Mid-century modern (Harper)",
          "group": "Plates and prints"
        },
        {
          "value": "watercolour",
          "label": "Modern watercolour",
          "group": "Plates and prints"
        },
        {
          "value": "sketch",
          "label": "Field sketch",
          "group": "Plates and prints"
        },
        {
          "value": "pixel",
          "label": "Pixel art",
          "group": "Playful"
        },
        {
          "value": "origami",
          "label": "Origami",
          "group": "Playful"
        },
        {
          "value": "hats",
          "label": "Hats and monocles",
          "group": "Playful"
        },
        {
          "value": "custom",
          "label": "Your own prompt",
          "group": "Your own"
        }
      ]
    },
    {
      "name": "art_prompt",
      "type": "textarea",
      "label": "Your own prompt",
      "default": "",
      "show_if": {
        "pictures": "gen",
        "art_style": "custom"
      },
      "help": "Describe the medium and the look; the widget adds the species, its photo and the white paper. For example: an Art Nouveau illustration with sinuous flowing lines, a muted palette of sage, ochre and dusty rose, on plain pure white paper."
    },
    {
      "name": "dapper",
      "type": "boolean",
      "label": "One dapper specimen a day",
      "default": false,
      "show_if": {
        "pictures": "gen"
      },
      "help": "One specimen on the sheet is painted in a small hat, and perhaps a monocle, in whatever style the sheet is in: the same one all day, another to-morrow. One extra painting a day at most."
    },
    {
      "name": "arrangement",
      "type": "select",
      "label": "Arrangement",
      "default": "sheet",
      "show_if": {
        "pictures": "gen"
      },
      "help": "The sheet lays the cut-outs out itself and costs nothing beyond the paintings. The painted scene asks fal.ai to repaint the whole sheet as one picture with one background (about US$0.04 each time), once every specimen is painted and cut out; the sheet shows until it lands. The model takes liberties with a scene, so the names go in a legend under it rather than on the specimens.",
      "choices": [
        {
          "value": "sheet",
          "label": "Specimen sheet"
        },
        {
          "value": "scene",
          "label": "Painted scene (AI)"
        }
      ]
    },
    {
      "name": "scene",
      "type": "select",
      "label": "Scene",
      "default": "auto",
      "show_if": {
        "pictures": "gen",
        "arrangement": "scene"
      },
      "choices": [
        {
          "value": "auto",
          "label": "To suit the kinds on the page"
        },
        {
          "value": "branch",
          "label": "One shared branch"
        },
        {
          "value": "tree",
          "label": "One tree"
        },
        {
          "value": "birdbath",
          "label": "A bird bath"
        },
        {
          "value": "wire",
          "label": "A telephone wire"
        },
        {
          "value": "feeder",
          "label": "A bird feeder"
        },
        {
          "value": "meadow",
          "label": "A wildflower meadow"
        },
        {
          "value": "sky",
          "label": "All in flight"
        },
        {
          "value": "wetland",
          "label": "A wetland's edge"
        },
        {
          "value": "garden",
          "label": "A cottage garden"
        },
        {
          "value": "floor",
          "label": "A forest floor (fungi)"
        },
        {
          "value": "log",
          "label": "A fallen mossy log (fungi)"
        },
        {
          "value": "bank",
          "label": "A woodland bank"
        },
        {
          "value": "bed",
          "label": "A garden bed (plants)"
        }
      ],
      "help": "To suit the kinds on the page gives birds a vignette of branches, fungi a forest floor, plants a garden bed, insects a meadow, frogs a wetland."
    },
    {
      "name": "scene_fidelity",
      "type": "select",
      "label": "How free fal.ai is",
      "default": "exact",
      "show_if": {
        "pictures": "gen",
        "arrangement": "scene"
      },
      "help": "Exact asks the model to keep each specimen where the sheet put it; free lets it move and resize them for the scene. Either way the model may take liberties, so the names go in a legend under the picture.",
      "choices": [
        {
          "value": "exact",
          "label": "Keep every specimen in place"
        },
        {
          "value": "free",
          "label": "Free to rearrange"
        }
      ]
    },
    {
      "name": "scene_every",
      "type": "select",
      "label": "Re-compose at most",
      "default": "3",
      "show_if": {
        "pictures": "gen",
        "arrangement": "scene"
      },
      "help": "A new scene is painted when the line-up changes, no more often than this.",
      "choices": [
        {
          "value": "1",
          "label": "hourly"
        },
        {
          "value": "3",
          "label": "every 3 hours"
        },
        {
          "value": "6",
          "label": "every 6 hours"
        },
        {
          "value": "24",
          "label": "daily"
        }
      ]
    },
