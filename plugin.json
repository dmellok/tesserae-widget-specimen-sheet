          "value": "10",
          "label": "10"
        },
        {
          "value": "12",
          "label": "12"
        },
        {
          "value": "16",
          "label": "16"
        }
      ]
    },
    {
      "name": "exclude",
      "type": "textarea",
      "label": "Leave out",
      "default": "",
      "help": "Species to leave off the sheet, one per line: a common or scientific name, a genus (Columba drops every pigeon in it), a kind (Insecta, insects, Birds) or a pattern such as *gull. An excluded species frees its place for the next. Case and accents don't matter."
    },
    {
      "name": "sizing",
      "type": "select",
      "label": "Sizes",
      "default": "true",
      "choices": [
        {
          "value": "true",
          "label": "True to life: a crow large, a wren small"
        },
        {
          "value": "busy",
          "label": "The most heard or recorded biggest"
        },
        {
          "value": "same",
          "label": "All alike"
        }
      ]
    },
    {
      "name": "labels",
      "type": "select",
      "label": "Labels",
      "default": "caption",
      "choices": [
        {
          "value": "caption",
          "label": "Captions under each specimen"
        },
        {
          "value": "tag",
          "label": "Specimen tags"
        },
        {
          "value": "key",
          "label": "Numbers, with a key beside the page"
        },
        {
          "value": "none",
          "label": "None: the page alone"
        }
      ]
    },
    {
      "name": "label_lines",
      "type": "multiselect",
      "label": "Label lines",
      "default": [
        "name",
        "count"
      ],
      "help": "In this order. The count says calls, observations or records to suit the source.",
      "choices": [
        {
          "value": "name",
          "label": "Name"
        },
        {
          "value": "sci",
          "label": "Scientific name"
        },
        {
          "value": "count",
          "label": "How many"
        },
        {
          "value": "last",
