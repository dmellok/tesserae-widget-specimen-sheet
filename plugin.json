  "settings": [
    {
      "name": "fal_api_key",
      "type": "string",
      "label": "fal.ai API key (clean cut-outs)",
      "secret": true,
      "default": "",
      "help": "With a key, every plate and photo on the sheet is cut out by a background-removal model on fal.ai (BiRefNet, well under a cent a picture, once per picture, at most 300 a day), so a plate with a painted sky or a photo arrives on the page as the specimen alone. Without one, pictures on plain paper are cut by their edges and photos are shown as soft ovals. Get a key at https://fal.ai/dashboard/keys; it is only sent to fal.run."
    },
    {
      "name": "gen_daily_cap",
      "type": "select",
      "label": "AI paintings per day",
      "default": "12",
      "help": "The most new AI paintings made in a day, at about US$0.04 each. Paintings are kept, so a place's species only cost once; raise this to fill a sheet faster.",
      "choices": [
        {
          "value": "6",
          "label": "6 (about US$0.24)"
        },
        {
          "value": "12",
          "label": "12 (about US$0.48)"
        },
        {
          "value": "24",
          "label": "24 (about US$0.96)"
        },
        {
          "value": "48",
          "label": "48 (about US$1.92)"
        },
        {
          "value": "96",
          "label": "96 (about US$3.84)"
        }
      ]
    },
    {
      "name": "exclude",
      "type": "textarea",
      "label": "Always leave out",
      "default": "",
      "help": "Species left off every Specimen Sheet cell, one per line, in the same form as a cell's Leave out list: a name, a genus, a kind or a pattern such as *gull."
    }
