    {
      "name": "quality",
      "type": "select",
      "label": "Observations",
      "default": "research",
      "choices": [
        {
          "value": "research",
          "label": "Research grade: the community agrees on the species"
        },
        {
          "value": "",
          "label": "Any with a species, agreed or not"
        }
      ],
      "show_if": {
        "source": "inaturalist"
      }
    },
    {
      "name": "count",
      "type": "select",
      "label": "How many",
      "default": "8",
      "help": "Specimens on the sheet: the most heard or recorded first.",
      "choices": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "8",
          "label": "8"
        },
