{
  "tesserae_compat": "1.x",
  "name": "Specimen Sheet",
  "version": "0.6.3",
  "kind": "widget",
  "description": "The birds and wildlife around the panel, cut out and packed onto one printed page, each as large as the page allows. From BirdNET-Go (what the microphone heard to-day), iNaturalist (what people found nearby lately) or GBIF (what is recorded here in this month of the year). Classic plates and the records' own photos, or AI paintings in twelve styles or one you build; a demo garden until BirdNET-Go is set up.",
  "icon": "ph-feather",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*"
  ],
  "render": {
    "needs_network": true
  },
  "cell_options": [
    {
      "name": "source",
      "type": "select",
      "label": "Source",
      "default": "birdnet_go",
      "help": "BirdNET-Go hears the birds to-day. iNaturalist is what people have found near a place lately. GBIF is what has been recorded near a place in this month of the year (it lags by weeks, so it is seasonal, not news).",
      "choices": [
        {
          "value": "birdnet_go",
          "label": "BirdNET-Go (heard to-day)"
        },
        {
          "value": "inaturalist",
          "label": "iNaturalist (found nearby lately)"
        },
        {
          "value": "gbif",
          "label": "GBIF (recorded here this month of the year)"
        }
      ]
    },
    {
      "name": "url",
      "type": "string",
      "label": "BirdNET-Go address",
      "default": "",
      "help": "Where BirdNET-Go's web page opens, for example http://birdnet.local:8080. Leave empty for a demo garden based on this cell's location.",
      "show_if": {
        "source": "birdnet_go"
      }
    },
    {
      "name": "token",
      "type": "string",
      "label": "BirdNET-Go bearer token (normally blank)",
      "default": "",
      "secret": true,
      "help": "BirdNET-Go's reads need no login, even with Basic Authentication on. Fill this only for a reverse proxy or build that wants a bearer token.",
      "show_if": {
        "source": "birdnet_go",
        "url": {
          "not": ""
        }
      }
    },
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "For iNaturalist and GBIF, the place to look around. For BirdNET-Go, the clock, sunrise and sunset, and the demo garden. Falls back to the app-level location."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "10",
      "choices": [
        {
          "value": "2",
          "label": "2 km"
        },
        {
          "value": "5",
          "label": "5 km"
        },
        {
          "value": "10",
          "label": "10 km"
        },
        {
          "value": "25",
          "label": "25 km"
