        },
        {
          "value": "flag",
          "label": "New or returning (BirdNET-Go)"
        },
        {
          "value": "who",
          "label": "Observer (iNaturalist, GBIF)"
        },
        {
          "value": "size",
          "label": "Length, L 38 cm (birds)"
        }
      ],
      "show_if": {
        "labels": [
          "caption",
          "tag"
        ]
      }
    },
